# ===========================================
# Clash 订阅合并器 环境配置
# ===========================================
# 复制此文件为 .env 并根据需要修改

# 服务器配置
PORT=8666
HOST=0.0.0.0

# 数据目录
DATA_DIR=/app/data

# 时区
TZ=Asia/Shanghai

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO

# ===========================================
# 性能调优
# ===========================================
# HTTP 请求超时时间（秒）
DEFAULT_TIMEOUT=30

# 订阅获取超时时间（秒）
SPEEDTEST_TIMEOUT=35

# ===========================================
# 订阅获取配置
# ===========================================
# 订阅获取时使用的 User-Agent
# 这会影响订阅服务器返回的节点类型（例如 anytls 协议支持）
# 示例:
#   - FlClash/v0.8.91 clash-verge Platform/windows
#   - FlClash/v0.8.91 clash-verge Platform/android
#   - clash-verge/v1.3.8
#   - clash-meta
SUBSCRIPTION_USER_AGENT=FlClash/v0.8.91 clash-verge Platform/windows

# ===========================================
# 备份配置
# ===========================================
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_KEEP_COUNT=7
