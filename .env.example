# ===========================================
# Clash Sub Merger Environment Configuration
# ===========================================
# Copy this file to .env and modify as needed

# Server Configuration
PORT=8666
HOST=0.0.0.0

# Data Directory
DATA_DIR=/app/data

# Timezone
TZ=Asia/Shanghai

# ===========================================
# Logging Configuration
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: text or json (json for log aggregation tools)
LOG_FORMAT=text

# ===========================================
# Performance Tuning
# ===========================================
# HTTP request timeout (seconds)
DEFAULT_TIMEOUT=30

# Subscription fetch timeout (seconds)
SPEEDTEST_TIMEOUT=10

# Health check timeout (seconds)
HEALTH_CHECK_TIMEOUT=2

# Max retries for failed requests
MAX_RETRIES=3

# Retry delay (seconds)
RETRY_DELAY=1

# Stats cache duration (seconds)
STATS_CACHE_DURATION=60

# Config cache duration (seconds)
CONFIG_CACHE_DURATION=5

# File lock timeout (seconds)
FILE_LOCK_TIMEOUT=10

# ===========================================
# Rate Limiting
# ===========================================
# Format: "count/period" (e.g., "10/minute", "100/hour")
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH_SINGLE=10/minute
RATE_LIMIT_REFRESH_ALL=5/minute
RATE_LIMIT_SPEEDTEST=5/minute
RATE_LIMIT_DEFAULT=200/minute

# ===========================================
# Go Speedtest Service
# ===========================================
GO_SPEEDTEST_URL=http://localhost:9876
GO_SPEEDTEST_PORT=9876

# ===========================================
# Security (Optional)
# ===========================================
# Allowed CORS origins (comma-separated, or * for all)
# CORS_ORIGINS=https://example.com,https://app.example.com

# ===========================================
# External Services (Optional)
# ===========================================
# Redis URL for caching (if enabled)
# REDIS_URL=redis://localhost:6379/0

# Sentry DSN for error tracking (if enabled)
# SENTRY_DSN=https://xxx@sentry.io/xxx


# ===========================================
# Backup Configuration
# ===========================================
# Enable automatic backups
AUTO_BACKUP_ENABLED=true

# Backup interval in hours
AUTO_BACKUP_INTERVAL_HOURS=24

# Number of backups to keep
AUTO_BACKUP_KEEP_COUNT=7

# ===========================================
# API Key Rotation
# ===========================================
# Enable key rotation check
KEY_ROTATION_CHECK_ENABLED=true

# Days before key rotation reminder
KEY_ROTATION_DAYS=90
