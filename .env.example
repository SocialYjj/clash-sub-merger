# ===========================================
# Clash 订阅合并器 环境配置
# ===========================================
# 复制此文件为 .env 并根据需要修改

# 服务器配置
# Docker Compose 对外端口；容器内固定监听 8666
HOST_PORT=8666
# 以下两项用于直接运行 server.py
PORT=8666
HOST=0.0.0.0

# 数据目录
DATA_DIR=/app/data

# 时区
TZ=Asia/Shanghai


# ===========================================
# 认证密码策略
# ===========================================
# 首次启动必填；至少 8 位，并同时包含字母和数字。
# 初始化成功后密码哈希会写入 data/config.json，此变量可从部署环境中移除。
INITIAL_ADMIN_PASSWORD=

# 管理员密码最小/最大长度
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=100

# 是否要求至少包含一个字母/数字
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_NUMBER=true

# 会话签名密钥（可选但推荐生产环境设置）
# 生成示例: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# 管理会话有效期（秒）及同时保留的最大会话数
SESSION_TTL_SECONDS=86400
MAX_ACTIVE_SESSIONS=20

# Prometheus /metrics 独立访问 Token；留空时该端点返回 404
METRICS_TOKEN=

# ===========================================
# 日志配置
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=text

# ===========================================
# API 文档
# ===========================================
# 生产默认关闭 /docs、/redoc、/openapi.json；本地调试需要时改为 true
ENABLE_API_DOCS=false

# ===========================================
# 性能调优
# ===========================================
# HTTP 请求超时时间（秒）
DEFAULT_TIMEOUT=30
CONNECT_TIMEOUT=10
READ_TIMEOUT=30
WRITE_TIMEOUT=10
HEALTH_CHECK_TIMEOUT=2

# 订阅获取遇到 DNS、连接超时、408、429 或 5xx 时的额外重试次数与基础等待时间
SUBSCRIPTION_FETCH_RETRIES=1
SUBSCRIPTION_FETCH_RETRY_DELAY_SECONDS=1

# “全部更新”同时刷新的订阅数
SUBSCRIPTION_REFRESH_CONCURRENCY=4

# 同一订阅刷新锁的最长等待时间（秒）；手动重复刷新会直接返回冲突
FILE_LOCK_TIMEOUT=10

# 配置、订阅 YAML 和统计缓存时间（秒）；设为 0 可禁用对应缓存
CONFIG_CACHE_DURATION=5
YAML_CACHE_DURATION=60
STATS_CACHE_DURATION=60

# 请求体与远端订阅响应上限（字节，默认均为 10 MiB）
MAX_REQUEST_SIZE=10485760
SUBSCRIPTION_MAX_BYTES=10485760

# 全局和高成本接口限流；格式遵循 SlowAPI，例如 10/minute
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH_SINGLE=10/minute
RATE_LIMIT_REFRESH_ALL=5/minute
RATE_LIMIT_SPEEDTEST=5/minute
RATE_LIMIT_NODE_TEST=600/minute
RATE_LIMIT_NODE_SAVE=30/minute
RATE_LIMIT_GEOIP=30/minute

# 定时刷新线程数、错过任务宽限时间和随机错峰窗口（秒）
SCHEDULED_REFRESH_WORKERS=4
SCHEDULED_REFRESH_MISFIRE_GRACE_SECONDS=300
SCHEDULED_REFRESH_JITTER_SECONDS=120

# 外部 HTTPS 请求是否验证证书；生产建议保持 true，遇到证书异常订阅源再临时改 false
HTTP_VERIFY_SSL=true
HTTP_MAX_KEEPALIVE=20
HTTP_MAX_CONNECTIONS=50

# 允许的跨域来源，逗号分隔；使用 * 时服务端不会允许携带 Cookie
CORS_ORIGINS=*

# GeoIP 查询超时时间（秒）及自定义 GeoIP API 最大响应（字节，默认 1 MiB）
GEOIP_LOOKUP_TIMEOUT=10
CUSTOM_GEOIP_MAX_RESPONSE_BYTES=1048576

# 测速代理请求超时时间（秒）
SPEEDTEST_TIMEOUT=10
GO_SPEEDTEST_ENABLED=true
GO_SPEEDTEST_PORT=9876
GO_SPEEDTEST_URL=http://localhost:9876

# 节点区域历史保留策略
NODE_REGION_HISTORY_MAX_AGE_DAYS=180
NODE_REGION_HISTORY_MAX_ENTRIES=20000

# ===========================================
# 订阅获取配置
# ===========================================
# User-Agent 模式选择
# - flclash: 自动使用最新 FlClash User-Agent（推荐）
#            格式: FlClash/v{version} clash-verge Platform/{os}
#            版本号会定期从 GitHub 自动更新
# - custom:  使用自定义 User-Agent
#            需要配置下面的 SUBSCRIPTION_CUSTOM_UA
SUBSCRIPTION_UA_MODE=flclash

# 自定义 User-Agent（仅当 SUBSCRIPTION_UA_MODE=custom 时生效）
# 示例:
#   - FlClash/v0.8.91 clash-verge Platform/windows
#   - clash-verge/v1.3.8
#   - ClashforWindows/0.19.23
#   - clash-meta
SUBSCRIPTION_CUSTOM_UA=FlClash/v0.8.91 clash-verge Platform/windows

# FlClash 版本更新检查时间（仅当 SUBSCRIPTION_UA_MODE=flclash 时生效）
# 格式: Cron 表达式 (分 时 日 月 周)
# 默认: 0 3 * * * (每天凌晨 3 点)
# 示例:
#   - 0 3 * * *     每天凌晨 3 点
#   - 0 */6 * * *   每 6 小时
#   - 0 0 * * 0     每周日凌晨
FLCLASH_VERSION_UPDATE_CRON=0 3 * * *

# 订阅任务配置为同一时刻（例如 0 0 * * *）时，会在上面的 jitter 窗口内错峰执行。

# ===========================================
# 备份配置
# ===========================================
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_KEEP_COUNT=7
